# AI Research Agent Environment Configuration
# Copy this file to .env and fill in your actual API keys

# =============================================================================
# REQUIRED API KEYS
# =============================================================================

# OpenRouter API Key (for LLM access)
# Get your key from: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Tavily API Key (for web search)
# Get your key from: https://tavily.com/
TAVILY_API_KEY=your_tavily_api_key_here

# =============================================================================
# OPTIONAL CONFIGURATION
# =============================================================================

# LLM Model (OpenRouter format)
# Default: gpt-3.5-turbo
# Other options: anthropic/claude-3-haiku, meta-llama/llama-3.1-8b-instruct, etc.
LLM_MODEL=gpt-3.5-turbo

# LLM Temperature (0.0 to 1.0)
# Lower = more focused, Higher = more creative
TEMPERATURE=0.1

# Search Configuration
MAX_SEARCH_RESULTS=5
MAX_RESEARCH_STEPS=3

# Server Configuration
HOST=0.0.0.0
PORT=8000

# Database
DATABASE_URL=sqlite:///./research_agent.db

# Environment
ENV=local
DEBUG_MODE=true
LOG_LEVEL=INFO
